String bericht = "";

void setup() {
  Serial.begin(9600);
}

void loop() {
  while (Serial.available() > 0) {
    char teken = Serial.read();

    if (teken == '\n') {
      Serial.print("Ontvangen: ");
      Serial.println(bericht);
      bericht = "";
    } 
    else if (teken != '\r') {
      bericht += teken;
    }
  }

  static unsigned long vorigeTijd = 0;

  if (millis() - vorigeTijd >= 1000) {
    Serial.println("Hallo vanaf Arduino");
    vorigeTijd = millis();
  }
}
