int sensors[] = {A7, A6, A5, A4, A3, A2, A1, A0};

void setup() {
  Serial.begin(9600);

  for (int i = 0; i < 8; i++) {
    pinMode(sensors[i], INPUT);
  }
}

void loop() {
  for (int i = 0; i < 8; i++) {
    Serial.print("S");
    Serial.print(i + 1);
    Serial.print(": ");
    Serial.print(digitalRead(sensors[i]));
    Serial.print("  ");
  }

  Serial.println();
  delay(200);
}
